# Copie ce fichier en .env et remplis avec les valeurs de ton projet Supabase
# (Supabase Dashboard > Project Settings > API).
#
# Supabase a un nouveau format de clés API :
#   - "publishable" (sb_publishable_...) : safe côté navigateur, remplace l'ancienne anon key
#   - "secret"      (sb_secret_...)      : côté serveur uniquement, remplace service_role
# Les anciennes clés JWT (anon / service_role) fonctionnent aussi.

# ── Exposées au front par Vite (préfixe VITE_ OBLIGATOIRE) ──────────
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx   # clé publishable (ou anon)

# ── Utilisées uniquement par le script d'import (scripts/import.mjs) ─
# La clé secrète contourne la RLS pour le seed initial.
# NE JAMAIS l'exposer côté front / la commit.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx           # clé secret (ou service_role)
